App(
    appid="casio_lab",
    name="CasioLab",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="casio_lab_app",
    requires=["gui", "storage"],
    stack_size=6 * 1024,
    fap_category="Tools",
    fap_version="0.2",
    fap_description="Casio G-Shock DW-H5600 protocol explorer and data lab",
    fap_author="CasioLab",
    sources=[
        "casio_lab.c",
        "ui/*.c",
        "data/*.c",
        "storage/*.c",
        "protocol/*.c",
        "casio/*.c",
        "ble/*.c",
        "control/*.c",
        "monitor/*.c",
        "proxy/*.c",
        "reverse/*.c",
    ],
)